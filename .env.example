# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
API_PORT=4000
CLINIC_TIMEZONE=Asia/Kolkata
# Host ports 5440 / 6380 avoid clashing with other local Postgres / Redis.
DATABASE_URL=postgresql://clinic:clinic@localhost:5440/clinic?schema=public
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
# Passwords for the seeded admin and doctor accounts (local dev only).
SEED_ADMIN_EMAIL=admin@clinic.test
SEED_ADMIN_PASSWORD=replace-me
SEED_DOCTOR_PASSWORD=replace-me

# --- Booking ---
SLOT_HOLD_MINUTES=10
SLOT_GENERATION_DAYS=14

# --- LLM ---
# ollama | bedrock | openai. The same variable switches chat and embeddings.
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

# Ollama (local, free). Pull both models first:
#   ollama pull qwen2.5:3b && ollama pull mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Amazon Bedrock. Credentials come from the standard AWS chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Payments (phase 5, Razorpay TEST mode only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications (phase 5) ---
# mock | ses
EMAIL_ADAPTER=mock
EMAIL_FROM=clinic@example.com

# --- Voice (phase 6) ---
DEEPGRAM_API_KEY=

# --- Observability (phase 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
